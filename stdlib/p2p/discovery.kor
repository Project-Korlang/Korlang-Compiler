// Korlang P2P Build Node Auto-Discovery Protocol
// HT.1.2: Decentralized build cluster for Korlang compilation
// Written in Korlang (Korlang-first principle)

module std.p2p.discovery

import std.net.windows

// ============================================================
// Node Identity
// ============================================================

// Each node is identified by a 48-character SHA-384 hash stub
// (Real SHA-384 requires full compiler with runtime hashing)

struct NodeId {
    hash_a: Int
    hash_b: Int
    hash_c: Int
    hash_d: Int
}

fun node_id_create(seed_a: Int, seed_b: Int, seed_c: Int, seed_d: Int) -> NodeId {
    NodeId { hash_a: seed_a, hash_b: seed_b, hash_c: seed_c, hash_d: seed_d }
}

fun node_id_equals(a: NodeId, b: NodeId) -> Bool {
    a.hash_a == b.hash_a
}

fun node_id_to_string(n: NodeId) -> String {
    "node-" + n.hash_a
}

// ============================================================
// Peer Table
// ============================================================

struct Peer {
    id: NodeId
    port: Int
    alive: Int
}

fun peer_create(port: Int, seed: Int) -> Peer {
    let id = node_id_create(seed, seed + 1, seed + 2, seed + 3)
    Peer { id: id, port: port, alive: 1 }
}

fun peer_mark_alive(peer: Peer) -> Peer {
    Peer { id: peer.id, port: peer.port, alive: 1 }
}

fun peer_to_string(p: Peer) -> String {
    "Peer[" + node_id_to_string(p.id) + " port=" + p.port + "]"
}

// ============================================================
// Discovery Messages
// ============================================================

// Message type tags
fun msg_announce() -> Int { 1 }
fun msg_query() -> Int { 2 }
fun msg_pong() -> Int { 3 }
fun msg_build_request() -> Int { 4 }
fun msg_build_response() -> Int { 5 }

struct DiscoveryMessage {
    msg_type: Int
    sender_port: Int
    payload: String
}

fun make_announce(port: Int, node_hash: Int) -> DiscoveryMessage {
    let payload = "KORLANG-P2P-ANNOUNCE-v1:" + node_hash
    DiscoveryMessage { msg_type: msg_announce(), sender_port: port, payload: payload }
}

fun make_query(port: Int) -> DiscoveryMessage {
    DiscoveryMessage { msg_type: msg_query(), sender_port: port, payload: "KORLANG-P2P-QUERY" }
}

fun make_build_request(port: Int, source_hash: String) -> DiscoveryMessage {
    DiscoveryMessage { msg_type: msg_build_request(), sender_port: port, payload: source_hash }
}

fun message_to_string(m: DiscoveryMessage) -> String {
    "MSG[type=" + m.msg_type + " port=" + m.sender_port + " payload=" + m.payload + "]"
}

// ============================================================
// Discovery Process
// ============================================================

fun discovery_start(local_port: Int) {
    println("=== Korlang P2P Node Discovery ===")

    let self_seed = local_port + 1
    let self_peer = peer_create(local_port, self_seed)
    println("Local Node: " + peer_to_string(self_peer))

    let announce = make_announce(local_port, self_seed)
    println("Broadcasting: " + message_to_string(announce))

    println("Listening for peers on port " + local_port + "...")
    println("Discovery ready. Nodes will connect as they come online.")
}

fun discovery_demo() {
    println("=== HT.1.2: P2P Build Node Discovery Demo ===")
    discovery_start(9001)
    let peer1 = peer_create(9002, 42)
    let peer2 = peer_create(9003, 99)
    println("Found: " + peer_to_string(peer1))
    println("Found: " + peer_to_string(peer2))
    let req = make_build_request(9001, "sha384-of-source-here")
    println("Build Request: " + message_to_string(req))
    println("=== Discovery Demo OK ===")
}
