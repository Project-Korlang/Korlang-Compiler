@import("std.sql")

module std.db.orm

/**
 * Model is a base interface/class enforcing database 
 * schema generation via compile-time reflection.
 */
abstract class Model {
    /**
     * Converts the Korlang class into an underlying SQL insert.
     */
    fun save() -> Result<Bool, Error> {
        // [STUB] Implement reflection based SQL writing using AST macros
        print("Inserting model into database...")
        return Result.Ok(true)
    }

    /**
     * Executes SQL delete.
     */
    fun delete() -> Result<Bool, Error> {
        print("Deleting model from database...")
        return Result.Ok(true)
    }
}

/**
 * QueryBuilder applies the pipeline flow data design 
 * to type-safe database extraction.
 */
class QueryBuilder<T : Model> {
    
    // Internal generic queries generated at compile time
    table: String
    
    init(table: String) {
        this.table = table
    }
    
    fun filter(condition: fun(T) -> Bool) -> QueryBuilder<T> {
        // Interprets the boolean lambda function into SQL WHERE syntaxes
        return this
    }
    
    fun sort(field: String, ascending: Bool = true) -> QueryBuilder<T> {
        return this
    }
    
    // Terminates the query and performs the async HTTP network fetch
    fun execute() -> Array<T> {
        print("Executing SQL query on table {this.table}")
        return []
    }
}
