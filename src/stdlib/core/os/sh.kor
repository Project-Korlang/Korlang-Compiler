    println("Executing shell command: " + cmd)
    // dispatcher.syscall_exec(cmd) 
    0
}

fun sh_pipe(cmds: List<String>) -> String {
    println("Piping commands...")
    ""
}

fun sh_exit_code() -> Int {
    0
}
